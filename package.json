  },
  "license": "MIT",
  "author": {
    "name": "Kaan Ozdokmeci",
    "email": "kaan@ozdokmeci.com",
    "url": ""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2h2d-co/pi-dont-change-my-defaults.git"
  },
  "files": [
    "extensions/pi-dont-change-my-defaults/index.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "check": "hk check --all --check",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "pack:dry": "npm pack --dry-run --allow-directory=all",
